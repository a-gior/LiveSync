{
  "name": "livesync",
  "displayName": "LiveSync",
  "description": "Instant file sync over SSH/SFTP with diff tracking and easy config UI.",
  "version": "1.0.9",
  "publisher": "agior",
  "icon": "resources/icons/livesync-logo-gold.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-gior/LiveSync.git"
  },
  "bugs": {
    "url": "https://github.com/a-gior/LiveSync/issues"
  },
  "homepage": "https://github.com/a-gior/LiveSync",
  "engines": {
    "vscode": "^1.96.4"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "sync",
    "sftp",
    "ssh",
    "file sync",
    "remote development",
    "remote sync",
    "deploy",
    "upload",
    "download",
    "live sync",
    "watch files"
  ],
  "activationEvents": [
    "onView:diffs",
    "workspaceContains:.vscode/livesync.json"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "livesync",
          "title": "LiveSync",
          "icon": "resources/icons/livesync-logo.png"
        }
      ]
    },
    "views": {
      "livesync": [
        {
          "id": "livesync.workspaces",
          "name": "Workspaces",
          "when": "livesync.multiRoot"
        },
        {
          "id": "livesync.diffs",
          "name": "Diffs",
          "contextualTitle": "LiveSync Diffs"
        }
      ]
    },
    "commands": [
      {
        "command": "livesync.configuration",
        "title": "Configure Workspace",
        "category": "LiveSync",
        "icon": "$(gear)"
      },
      {
        "command": "livesync.resolve.keepRemote",
        "title": "Keep Remote (Download)",
        "category": "LiveSync",
        "icon": "$(arrow-down)"
      },
      {
        "command": "livesync.resolveFolder.keepLocal",
        "title": "Resolve Folder: Keep Local (Upload)",
        "category": "LiveSync",
        "icon": "$(arrow-up)"
      },
      {
        "command": "livesync.resolveFolder.keepRemote",
        "title": "Resolve Folder: Keep Remote (Download)",
        "category": "LiveSync",
        "icon": "$(arrow-down)"
      },
      {
        "command": "livesync.view.toggleShowUnchanged",
        "title": "Toggle Show Unchanged",
        "category": "LiveSync",
        "icon": "$(eye)"
      },
      {
        "command": "livesync.experimental.refresh",
        "title": "Refresh Current Workspace",
        "category": "LiveSync",
        "icon": "$(refresh)"
      },
      {
        "command": "livesync.experimental.refreshAll",
        "title": "Refresh All Workspaces",
        "category": "LiveSync",
        "icon": "$(sync)"
      },
      {
        "command": "livesync.experimental.node.showDiff",
        "title": "Show Diff (Remote ↔ Local)",
        "category": "LiveSync",
        "icon": "$(arrow-both)"
      },
      {
        "command": "livesync.experimental.node.applyToRemote",
        "title": "Apply to Remote",
        "category": "LiveSync",
        "icon": "$(arrow-up)"
      },
      {
        "command": "livesync.experimental.folder.applyToRemoteRecursively",
        "title": "Apply Folder to Remote (Recursive)",
        "category": "LiveSync",
        "icon": "$(arrow-up)"
      },
      {
        "command": "livesync.experimental.node.applyFromRemote",
        "title": "Download from Remote",
        "category": "LiveSync",
        "icon": "$(arrow-down)"
      },
      {
        "command": "livesync.experimental.folder.applyFromRemoteRecursively",
        "title": "Download Folder from Remote (Recursive)",
        "category": "LiveSync",
        "icon": "$(arrow-down)"
      },
      {
        "command": "livesync.focusExperimentalView",
        "title": "Focus LiveSync View",
        "category": "LiveSync",
        "icon": "$(telescope)"
      },
      {
        "command": "livesync.view.switchToTree",
        "title": "Switch to Tree View",
        "category": "LiveSync",
        "icon": "$(list-tree)"
      },
      {
        "command": "livesync.view.switchToList",
        "title": "Switch to List View",
        "category": "LiveSync",
        "icon": "$(list-flat)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "livesync.resolve.keepLocal",
          "when": "view == livesync.diffs && viewItem == fileEntry-file-conflict",
          "group": "inline@0"
        },
        {
          "command": "livesync.resolve.keepRemote",
          "when": "view == livesync.diffs && livesync.supportsDownload && viewItem == fileEntry-file-modified",
          "group": "inline@0"
        },
        {
          "command": "livesync.resolve.keepRemote",
          "when": "view == livesync.diffs && livesync.supportsDownload && viewItem == fileEntry-file-conflict",
          "group": "inline@0"
        },
        {
          "command": "livesync.resolveFolder.keepLocal",
          "when": "view == livesync.diffs && viewItem == fileEntry-directory-modified",
          "group": "navigation@1"
        },
        {
          "command": "livesync.resolveFolder.keepLocal",
          "when": "view == livesync.diffs && viewItem == fileEntry-directory-conflict",
          "group": "navigation@1"
        },
        {
          "command": "livesync.resolveFolder.keepRemote",
          "when": "view == livesync.diffs && livesync.supportsDownload && viewItem == fileEntry-directory-modified",
          "group": "navigation@1"
        },
        {
          "command": "livesync.resolveFolder.keepRemote",
          "when": "view == livesync.diffs && livesync.supportsDownload && viewItem == fileEntry-directory-conflict",
          "group": "navigation@1"
        },
        {
          "command": "livesync.experimental.node.applyToRemote",
          "when": "view == livesync.diffs && viewItem =~ /fileEntry-file-(added|removed|modified|conflict)$/",
          "group": "inline@1"
        },
        {
          "command": "livesync.experimental.node.applyFromRemote",
          "when": "view == livesync.diffs && viewItem == fileEntry-file-modified && livesync.supportsDownload",
          "group": "inline@2"
        },
        {
          "command": "livesync.experimental.node.applyFromRemote",
          "when": "view == livesync.diffs && viewItem == fileEntry-file-removed && livesync.supportsDownload",
          "group": "inline@2"
        },
        {
          "command": "livesync.experimental.node.applyFromRemote",
          "when": "view == livesync.diffs && viewItem == fileEntry-file-conflict && livesync.supportsDownload",
          "group": "inline@2"
        },
        {
          "command": "livesync.experimental.node.showDiff",
          "when": "view == livesync.diffs && viewItem == fileEntry-file-modified && livesync.supportsDownload",
          "group": "inline@3"
        },
        {
          "command": "livesync.experimental.node.showDiff",
          "when": "view == livesync.diffs && viewItem == fileEntry-file-conflict && livesync.supportsDownload",
          "group": "inline@3"
        },
        {
          "command": "livesync.experimental.folder.applyToRemoteRecursively",
          "when": "view == livesync.diffs && viewItem == fileEntry-directory-added",
          "group": "navigation@2"
        },
        {
          "command": "livesync.experimental.folder.applyToRemoteRecursively",
          "when": "view == livesync.diffs && viewItem == fileEntry-directory-modified",
          "group": "navigation@2"
        },
        {
          "command": "livesync.experimental.folder.applyToRemoteRecursively",
          "when": "view == livesync.diffs && viewItem == fileEntry-directory-removed",
          "group": "navigation@2"
        },
        {
          "command": "livesync.experimental.folder.applyFromRemoteRecursively",
          "when": "view == livesync.diffs && viewItem == fileEntry-directory-modified && livesync.supportsDownload",
          "group": "navigation@3"
        },
        {
          "command": "livesync.experimental.folder.applyFromRemoteRecursively",
          "when": "view == livesync.diffs && viewItem == fileEntry-directory-removed && livesync.supportsDownload",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "livesync.experimental.node.applyToRemote",
          "group": "inline@1"
        },
        {
          "command": "livesync.experimental.node.applyFromRemote",
          "group": "inline@2"
        },
        {
          "command": "livesync.experimental.node.showDiff",
          "group": "inline@3"
        }
      ],
      "view/title": [
        {
          "command": "livesync.resolveFolder.keepLocal",
          "when": "view == livesync.diffs",
          "group": "navigation@5",
          "icon": "$(arrow-up)"
        },
        {
          "command": "livesync.resolveFolder.keepRemote",
          "when": "view == livesync.diffs && livesync.supportsDownload",
          "group": "navigation@6",
          "icon": "$(arrow-down)"
        },
        {
          "command": "livesync.view.toggleShowUnchanged",
          "when": "view == livesync.diffs",
          "group": "navigation@1",
          "icon": "$(eye)"
        },
        {
          "command": "livesync.experimental.refresh",
          "when": "view == livesync.diffs",
          "group": "navigation@2"
        },
        {
          "command": "livesync.experimental.refreshAll",
          "when": "view == livesync.workspaces && livesync.multiRoot",
          "group": "navigation@1"
        },
        {
          "command": "livesync.view.switchToTree",
          "when": "view == livesync.diffs && livesyncViewMode == list",
          "group": "navigation@1"
        },
        {
          "command": "livesync.view.switchToList",
          "when": "view == livesync.diffs && livesyncViewMode == tree",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "livesync.experimental.node.showDiff",
          "group": "LiveSync@1"
        },
        {
          "command": "livesync.experimental.node.applyToRemote",
          "group": "LiveSync@2"
        },
        {
          "command": "livesync.experimental.node.applyFromRemote",
          "group": "LiveSync@3"
        }
      ]
    },
    "configuration": {
      "title": "LiveSync",
      "properties": {
        "livesync.index.concurrency": {
          "type": "integer",
          "scope": "resource",
          "default": 4,
          "minimum": 1,
          "maximum": 32,
          "markdownDescription": "Number of files hashed in parallel during local indexing. Higher = faster but more disk I/O."
        },
        "livesync.view.showUnchanged": {
          "type": "boolean",
          "default": false,
          "description": "Show unchanged items in the LiveSync tree. When disabled, unchanged files/folders are hidden."
        },
        "livesync.view.recentlyResolvedRetentionMs": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "description": "How long (in ms) to keep just-resolved items visible before hiding when unchanged entries are hidden."
        },
        "livesync.openMode": {
          "type": "string",
          "enum": [
            "prompt",
            "ui",
            "json"
          ],
          "default": "prompt",
          "description": "When running **LiveSync: Configure Workspace**, should LiveSync…\n- **prompt**: ask each time whether to use the UI panel or raw JSON\n- **ui**: open the custom LiveSync UI panel by default\n- **json**: open the `livesync.json` file by default"
        },
        "livesync.refreshOnConfigSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Refresh differences after saving a LiveSync config file."
        },
        "livesync.statusBar.visibleItems": {
          "type": "array",
          "scope": "window",
          "description": "Choose which LiveSync status bar items may be shown.",
          "default": [
            "messages",
            "permanent",
            "progress",
            "errors"
          ],
          "items": {
            "type": "string",
            "enum": [
              "messages",
              "permanent",
              "progress",
              "errors"
            ],
            "markdownEnumDescriptions": [
              "Informational messages",
              "Gear button (Livesync) to open configuration settings",
              "The percentage/progress indicator.",
              "The indicator showing the number of fatal configuration error of workspace folders"
            ]
          },
          "uniqueItems": true
        },
        "livesync.view.showAsTree": {
          "type": "boolean",
          "default": true,
          "description": "Show files in tree structure (true) or flat list (false)"
        }
      }
    }
  },
  "scripts": {
    "install:dev": "npm install && cd webview-ui && npm install",
    "install:prod": "npm run clean-install && cd webview-ui && npm run clean-install",
    "clean-install": "rm -rf node_modules package-lock.json && npm install --omit=dev",
    "start:webview": "cd webview-ui && npm run dev",
    "build:webview": "cd webview-ui && npm run build",
    "vscode:prepublish": "npm run prepare-package",
    "prepare-package": "npm run generate-deps-vscodeignore && rm -rf node_modules package-lock.json && npm install && npm run compile && cd webview-ui && rm -rf node_modules package-lock.json && npm install && npm run build",
    "generate-deps-vscodeignore": "node scripts/generateVscodeIgnore.js",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "build": "tsc -p . && tsc-alias -p tsconfig.json",
    "watch": "run-p watch:ts watch:alias",
    "watch:ts": "tsc -w -p .",
    "watch:alias": "tsc-alias -p tsconfig.json -w",
    "test:fast": "mocha",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha 'test/unit/**/*.spec.ts'",
    "test:integration": "mocha 'test/integration/**/*.spec.ts'",
    "test:ext": "npm run build && vscode-test",
    "test:all": "npm run test && npm run test:ext",
    "test:watch": "mocha --watch",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov npm test",
    "test:coverage:unit": "c8 --reporter=text npm run test:unit",
    "test:debug": "node --inspect-brk node_modules/.bin/mocha",
    "clean": "rimraf out coverage .nyc_output"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.129",
    "@types/sinon": "^17.0.4",
    "@types/ssh2": "^1.15.0",
    "@types/ssh2-sftp-client": "^9.0.3",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.96.4",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.5.2",
    "c8": "^10.1.3",
    "esbuild": "^0.25.0",
    "esbuild-node-externals": "^1.18.0",
    "eslint": "^8.57.0",
    "glob": "^10.3.12",
    "husky": "^9.0.11",
    "jsonc-parser": "^3.2.1",
    "lint-staged": "^15.2.2",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "prettier": "3.2.5",
    "rimraf": "^5.0.10",
    "sinon": "^21.0.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.2.3"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "minimatch": "^9.0.5",
    "net": "^1.0.2",
    "p-limit": "^3.1.0",
    "p-map": "^4.0.0",
    "ssh2": "^1.15.0",
    "ssh2-sftp-client": "^11.0.0",
    "tmp-promise": "^3.0.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
