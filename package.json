{
  "name": "livesync",
  "displayName": "LiveSync",
  "description": "Instant file sync over SSH/SFTP with diff tracking and easy config UI.",
  "version": "1.1.0",
  "publisher": "agior",
  "icon": "resources/icons/livesync-logo-gold.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-gior/LiveSync.git"
  },
  "bugs": {
    "url": "https://github.com/a-gior/LiveSync/issues"
  },
  "homepage": "https://github.com/a-gior/LiveSync",
  "engines": {
    "vscode": "^1.96.4"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "sync",
    "sftp",
    "ssh",
    "file sync",
    "remote development",
    "remote sync",
    "deploy",
    "upload",
    "download",
    "live sync",
    "watch files"
  ],
  "activationEvents": [
    "onView:diffs",
    "workspaceContains:.vscode/livesync.json"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "livesync",
          "title": "LiveSync",
          "icon": "resources/icons/livesync-logo.png"
        }
      ]
    },
    "views": {
      "livesync": [
        {
          "id": "livesync.workspaces",
          "name": "Workspaces",
          "when": "livesync.multiRoot"
        },
        {
          "id": "livesync.diffs",
          "name": "Diffs",
          "contextualTitle": "LiveSync Diffs"
        }
      ]
    },
    "commands": [
      {
        "command": "livesync.configuration",
        "title": "Configure Workspace",
        "category": "LiveSync",
        "icon": "$(gear)"
      },
      {
        "command": "livesync.upload",
        "title": "Upload",
        "category": "LiveSync",
        "icon": "$(arrow-up)"
      },
      {
        "command": "livesync.download",
        "title": "Download",
        "category": "LiveSync",
        "icon": "$(arrow-down)"
      },
      {
        "command": "livesync.uploadFolder",
        "title": "Upload Folder",
        "category": "LiveSync",
        "icon": "$(arrow-up)"
      },
      {
        "command": "livesync.downloadFolder",
        "title": "Download Folder",
        "category": "LiveSync",
        "icon": "$(arrow-down)"
      },
      {
        "command": "livesync.experimental.node.showDiff",
        "title": "Show Diff",
        "category": "LiveSync",
        "icon": "$(arrow-both)"
      },
      {
        "command": "livesync.view.toggleShowUnchanged",
        "title": "Toggle Show Unchanged",
        "category": "LiveSync",
        "icon": "$(eye)"
      },
      {
        "command": "livesync.refresh",
        "title": "Refresh",
        "category": "LiveSync",
        "icon": "$(refresh)"
      },
      {
        "command": "livesync.refreshAll",
        "title": "Refresh All",
        "category": "LiveSync",
        "icon": "$(sync)"
      },
      {
        "command": "livesync.view.switchToTree",
        "title": "Switch to Tree View",
        "category": "LiveSync",
        "icon": "$(list-tree)"
      },
      {
        "command": "livesync.view.switchToList",
        "title": "Switch to List View",
        "category": "LiveSync",
        "icon": "$(list-flat)"
      },
      {
        "command": "livesync.testConnection",
        "title": "Test Connection",
        "category": "LiveSync",
        "icon": "$(plug)"
      },
      {
        "command": "livesync.delete",
        "title": "Delete",
        "category": "LiveSync",
        "icon": "$(trash)"
      },
      {
        "command": "livesync.deleteFolder",
        "title": "Delete Folder",
        "category": "LiveSync",
        "icon": "$(trash)"
      },
      {
        "command": "livesync.uploadWorkspace",
        "title": "Upload Workspace",
        "category": "LiveSync",
        "icon": "$(repo-push)"
      },
      {
        "command": "livesync.downloadWorkspace",
        "title": "Download Workspace",
        "category": "LiveSync",
        "icon": "$(repo-pull)"
      },
      {
        "command": "livesync.showLogs",
        "title": "Show Logs",
        "category": "LiveSync",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "livesync.upload",
          "when": "view == livesync.diffs && viewItem =~ /fileEntry-file-(added|modified|conflict)$/",
          "group": "inline@0"
        },
        {
          "command": "livesync.download",
          "when": "view == livesync.diffs && viewItem =~ /fileEntry-file-(removed|modified|conflict)$/",
          "group": "inline@1"
        },
        {
          "command": "livesync.experimental.node.showDiff",
          "when": "view == livesync.diffs && viewItem =~ /fileEntry-file-(modified|conflict)$/",
          "group": "inline@2"
        },
        {
          "command": "livesync.uploadFolder",
          "when": "view == livesync.diffs && viewItem =~ /fileEntry-directory-(added|modified|conflict)$/",
          "group": "inline@0"
        },
        {
          "command": "livesync.downloadFolder",
          "when": "view == livesync.diffs && viewItem =~ /fileEntry-directory-(removed|modified|conflict)$/",
          "group": "inline@1"
        },
        {
          "command": "livesync.delete",
          "when": "view == livesync.diffs && viewItem =~ /fileEntry-file-/",
          "group": "inline@3"
        },
        {
          "command": "livesync.deleteFolder",
          "when": "view == livesync.diffs && viewItem =~ /fileEntry-directory-/",
          "group": "inline@3"
        }
      ],
      "editor/context": [
        {
          "command": "livesync.upload",
          "group": "LiveSync@1"
        },
        {
          "command": "livesync.download",
          "group": "LiveSync@2"
        },
        {
          "command": "livesync.experimental.node.showDiff",
          "group": "LiveSync@3"
        },
        {
          "command": "livesync.delete",
          "group": "LiveSync@4"
        }
      ],
      "view/title": [
        {
          "command": "livesync.view.toggleShowUnchanged",
          "when": "view == livesync.diffs",
          "group": "navigation@1",
          "icon": "$(eye)"
        },
        {
          "command": "livesync.refresh",
          "when": "view == livesync.diffs",
          "group": "navigation@2"
        },
        {
          "command": "livesync.refreshAll",
          "when": "view == livesync.workspaces && livesync.multiRoot",
          "group": "navigation@1"
        },
        {
          "command": "livesync.view.switchToTree",
          "when": "view == livesync.diffs && livesyncViewMode == list",
          "group": "navigation@3"
        },
        {
          "command": "livesync.view.switchToList",
          "when": "view == livesync.diffs && livesyncViewMode == tree",
          "group": "navigation@3"
        },
        {
          "command": "livesync.uploadWorkspace",
          "when": "view == livesync.diffs",
          "group": "navigation@4",
          "icon": "$(repo-push)"
        },
        {
          "command": "livesync.downloadWorkspace",
          "when": "view == livesync.diffs",
          "group": "navigation@5",
          "icon": "$(repo-pull)"
        }
      ],
      "explorer/context": [
        {
          "command": "livesync.upload",
          "group": "LiveSync@1"
        },
        {
          "command": "livesync.download",
          "group": "LiveSync@2"
        },
        {
          "command": "livesync.experimental.node.showDiff",
          "group": "LiveSync@3"
        },
        {
          "command": "livesync.delete",
          "group": "LiveSync@4"
        }
      ]
    },
    "configuration": {
      "title": "LiveSync",
      "properties": {
        "livesync.index.concurrency": {
          "type": "integer",
          "scope": "resource",
          "default": 4,
          "minimum": 1,
          "maximum": 32,
          "markdownDescription": "Number of files hashed in parallel during local indexing. Higher = faster but more disk I/O."
        },
        "livesync.view.recentlyResolvedRetentionMs": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "description": "How long (in ms) to keep just-resolved items visible before hiding when unchanged entries are hidden."
        },
        "livesync.openMode": {
          "type": "string",
          "enum": [
            "prompt",
            "ui",
            "json"
          ],
          "default": "prompt",
          "description": "When running **LiveSync: Configure Workspace**, should LiveSync…\n- **prompt**: ask each time whether to use the UI panel or raw JSON\n- **ui**: open the custom LiveSync UI panel by default\n- **json**: open the `livesync.json` file by default"
        },
        "livesync.refreshOnConfigSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Refresh differences after saving a LiveSync config file."
        },
        "livesync.statusBar.visibleItems": {
          "type": "array",
          "scope": "window",
          "description": "Choose which LiveSync status bar items may be shown.",
          "default": [
            "messages",
            "permanent",
            "progress",
            "errors"
          ],
          "items": {
            "type": "string",
            "enum": [
              "messages",
              "permanent",
              "progress",
              "errors"
            ],
            "markdownEnumDescriptions": [
              "Informational messages",
              "Gear button (Livesync) to open configuration settings",
              "The percentage/progress indicator.",
              "The indicator showing the number of fatal configuration error of workspace folders"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  },
  "scripts": {
    "install:dev": "npm install && cd webview-ui && npm install",
    "install:prod": "npm run clean-install && cd webview-ui && npm run clean-install",
    "clean-install": "rm -rf node_modules package-lock.json && npm install --omit=dev",
    "start:webview": "cd webview-ui && npm run dev",
    "build:webview": "cd webview-ui && npm run build",
    "vscode:prepublish": "npm run prepare-package",
    "prepare-package": "npm run generate-deps-vscodeignore && rm -rf node_modules package-lock.json && npm install && npm run compile && cd webview-ui && rm -rf node_modules package-lock.json && npm install && npm run build",
    "generate-deps-vscodeignore": "node scripts/generateVscodeIgnore.js",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "build": "tsc -p . && tsc-alias -p tsconfig.json",
    "watch": "run-p watch:ts watch:alias",
    "watch:ts": "tsc -w -p .",
    "watch:alias": "tsc-alias -p tsconfig.json -w",
    "test:fast": "mocha",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "mocha 'test/unit/**/*.spec.ts'",
    "test:integration": "mocha 'test/integration/**/*.spec.ts'",
    "test:e2e": "npm run compile && vscode-test",
    "test:watch": "mocha --watch",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov npm test",
    "test:coverage:unit": "c8 --reporter=text npm run test:unit",
    "test:debug": "node --inspect-brk node_modules/.bin/mocha",
    "clean": "rimraf out coverage .nyc_output"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/mocha": "^10.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^18.19.129",
    "@types/sinon": "^17.0.4",
    "@types/ssh2": "^1.15.0",
    "@types/ssh2-sftp-client": "^9.0.3",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.96.4",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.5.2",
    "c8": "^10.1.3",
    "esbuild": "^0.25.0",
    "esbuild-node-externals": "^1.18.0",
    "eslint": "^9.39.2",
    "glob": "^11.0.0",
    "husky": "^9.0.11",
    "jsonc-parser": "^3.2.1",
    "lint-staged": "^15.2.2",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "prettier": "3.2.5",
    "rimraf": "^6.0.0",
    "sinon": "^21.0.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.2.3",
    "typescript-eslint": "^8.51.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "minimatch": "^9.0.5",
    "module-alias": "^2.2.3",
    "net": "^1.0.2",
    "p-limit": "^3.1.0",
    "p-map": "^4.0.0",
    "ssh2": "^1.15.0",
    "ssh2-sftp-client": "^11.0.0",
    "tmp-promise": "^3.0.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
